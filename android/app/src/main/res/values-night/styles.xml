<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Keep a light window even when the device is in Dark Mode,
         so the status bar does not fall back to black behind cream screens. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#FFFAF6F0</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">#FFFAF6F0</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#FFFAF6F0</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
